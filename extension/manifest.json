{
  "manifest_version": 3,
  "name": "MiCirql Tools — Website Capture",
  "version": "0.3.7",
  "description": "Local full-page and bulk screenshot capture with verified Chrome download completion and progress.",
  "permissions": [
    "debugger",
    "tabs",
    "downloads",
    "activeTab",
    "scripting",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "MiCirql Tools",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://export.micirql.com/*",
        "https://tools.micirql.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
